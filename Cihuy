<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Video Player</title>

<style>
html, body {
    margin: 0;
    width: 100%;
    height: 100%;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #111;
    font-family: Arial, sans-serif;
}

.video-container {
    width: 90%;
    max-width: 800px;
}

video {
    width: 100%;
    display: block;
    border-radius: 12px;
    background: #000;
}
</style>
</head>

<body>

<div class="video-container">

    <video
        id="video"
        controls
        playsinline
        preload="metadata">

        <source
            src="https://www.image2url.com/r2/default/videos/1791126757233-35ff92a1-f720-492c-a119-852f86854f47.mp4"
            type="video/mp4">

        Browser kamu tidak mendukung pemutar video.
    </video>

</div>

</body>
</html>
